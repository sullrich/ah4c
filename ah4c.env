HOST_DIR=/data

# Closed captions have no environment variables, on purpose. The switch, the
# speech model, the language, the letter case, the subtitle files and whether it
# runs on the processor or a GPU are all set on the Closed Captions page and
# stored in captions/config.json.
#
# That file, the downloaded model, the engine and any GPU driver live in
# $HOST_DIR/ah4c/captions on the host, which the compose file binds to
# /opt/captions. The directory stays empty until captions are switched on.
#
# To let captions use a GPU, uncomment the matching block in the compose file:
# devices /dev/dri for the Vulkan engine build, or the NVIDIA reservation for
# the CUDA build. Neither is needed to run on the processor.

